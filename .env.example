# --- Supabase (shared MindLarp project) -------------------------------------
# Local dev: values printed by `npm run db:start` (http://127.0.0.1:56321).
# Production: the same project used by mindlarp-site and admin-console.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# --- Security ----------------------------------------------------------------
# 32+ random bytes used to encrypt provider API keys at rest (AES-256-GCM).
# Generate: openssl rand -base64 32
KEY_ENCRYPTION_SECRET=replace-with-random-secret

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Linked properties shown in Settings → Integration.
NEXT_PUBLIC_CONSOLE_URL=https://console.mindlarp.com
NEXT_PUBLIC_MAIN_SITE_URL=https://mindlarp.com
# Optional: share the Supabase session cookie across subdomains (true SSO with
# admin-console), e.g. ".mindlarp.com". Leave empty for host-only cookies.
AUTH_COOKIE_DOMAIN=

# --- Sign-in: direct Google / GitHub OAuth -----------------------------------
# The SAME regular client ids/secrets the main site (mindlarp.com) uses.
# Supabase's OAuth providers are not involved. Add this app's callback to the
# OAuth app's authorized redirect URIs:
#   https://chat.mindlarp.com/auth/oauth/google/callback
#   https://chat.mindlarp.com/auth/oauth/github/callback
# (locally: http://localhost:3000/auth/oauth/<provider>/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Optional server-side provider keys --------------------------------------
# When set, users can pick "Server default" instead of adding their own key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=